# Copy to .env or use hw-ai-agent setup with hidden key entry.
AGENT_PROVIDER=openrouter
OPENROUTER_MODEL=deepseek/deepseek-v3.2
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
# For --provider openai also fill these locally:
OPENAI_MODEL=
OPENAI_API_KEY=
# Ollama needs no secret key. Install and pull the model first.
OLLAMA_MODEL=qwen3:4b
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
