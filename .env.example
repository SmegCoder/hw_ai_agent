# Copy to .env or use hw-ai-agent setup with hidden key entry.
AGENT_PROVIDER=openrouter
OPENROUTER_MODEL=deepseek/deepseek-v3.2
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
# For --provider openai also fill these locally:
OPENAI_MODEL=
OPENAI_API_KEY=
# Ollama needs no secret key. Install and pull the model first.
OLLAMA_MODEL=qwen3:4b
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Defaults for every new run; a command-line flag overrides the corresponding value.
# If omitted, legacy demo-specific defaults still apply (see help).
AGENT_MAX_ROUNDS=12
AGENT_MAX_TOKENS=2048
AGENT_MAX_TOOL_CALLS=128
AGENT_MAX_SIDE_EFFECTS=32
AGENT_MAX_RESULT_BYTES=1000000
AGENT_MODE=safe
AGENT_APPROVALS=ask
AGENT_WORKSPACE=workspace
AGENT_STATE_DB=.agent/sessions.sqlite3
AGENT_PLAN=false
AGENT_TASKS=false
AGENT_JOURNAL=false
# Optional JSON policy, outside workspace:
# AGENT_POLICY=policies/review.json

# Opt-in routing for NEW sessions (explicit --model ID still wins):
AGENT_ROUTE=false
# Optional provider-specific routing pool overrides:
# AGENT_ROUTE_SIMPLE_MODEL=deepseek/deepseek-v4.1-flash
# AGENT_ROUTE_MEDIUM_MODEL=qwen/qwen3-coder
# AGENT_ROUTE_COMPLEX_MODEL=anthropic/claude-sonnet-4.6
# --model '?' opens a terminal picker; --model auto enables routing for one launch.

# Pre-request estimates; actual costs and session totals are always recorded:
AGENT_COST_ESTIMATE=true
# Override for one launch: --cost-estimate / --no-cost-estimate (also resume).
